# Copy to .env (gitignored) and fill in. Values are REQUIRED at startup UNLESS
# the comment above them says otherwise — the optional ones are left COMMENTED
# OUT so a copied file cannot arm a switch nobody chose. Uncomment deliberately.

# ES256 keypair for Realm credentials. Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out realm_jwt_private.pem
#   openssl ec -in realm_jwt_private.pem -pubout -out realm_jwt_public.pem
# The PRIVATE key is used ONLY by the /exchange handler; the PUBLIC key ONLY by
# the /livekit-token handler. Newlines may be encoded as literal \n.
REALM_JWT_PRIVATE_KEY=
REALM_JWT_PUBLIC_KEY=

# LiveKit API credentials — the SAME key/secret pair in the box's livekit.yaml.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase project id — the ONLY Firebase config needed. verifyIdToken uses
# Google's public certs, so no service-account JSON is required.
FIREBASE_PROJECT_ID=adventures-in-tech-world-0

# Browser origins allowed to call /exchange and /livekit-token, comma-separated
# and exact-match. REQUIRED — the Flutter web client cannot reach either endpoint
# without it. Never `*`: callers send a bearer credential. Matches the storage
# bucket's CORS policy (world.imagineering.cc).
# Each entry must be exactly scheme://host[:port] — no trailing slash, no path,
# no default port. The server refuses to boot otherwise, because every such
# value matches nothing and is indistinguishable at runtime from no CORS at all.
# Under NODE_ENV=production every entry must be an https DNS name: https alone
# does not exclude loopback (https://app.localhost and https://[::1] are both
# valid https origins), so IP literals and anything under .localhost are refused
# as well.
CORS_ALLOWED_ORIGINS=https://world.imagineering.cc

# How many proxy hops in front of this process are trusted to have written
# X-Forwarded-For. REQUIRED under NODE_ENV=production, which the Dockerfile sets
# — the deployed container is never reached directly, and this value decides
# whether the per-IP rate limit is per-IP at all.
#
# 1 is correct for the OCI box: Caddy terminates TLS and reverse-proxies to
# 127.0.0.1:8791, appending the peer address. Both wrong values fail SILENTLY —
# too low and every request looks like it came from the docker bridge gateway,
# so the whole internet shares one bucket and any single caller throttles
# everyone; too high and a caller supplies its own address per request and the
# limit stops existing. Neither shows up as an error.
TRUST_PROXY_HOPS=1

# Shared secret the reverse proxy presents so its X-Forwarded-For is believed.
# OPTIONAL: unset means unenforced, which is the behaviour before this existed.
#
# TRUST_PROXY_HOPS alone is not enough on this deploy. Caddy runs with
# network_mode: host and reaches the container through the published port
# 127.0.0.1:8791, so it arrives from the docker bridge gateway — the same address
# as EVERY other process on the host. Measured 2026-08-20: a plain curl on the box
# with a forged X-Forwarded-For was believed, and the per-IP limiter keyed on the
# address that curl chose. No hop count or address can separate the two; only a
# secret can.
#
# Set the SAME value in the Caddyfile. DELETE the client's copy first — the
# leading `-` is load-bearing, not style:
#     reverse_proxy 127.0.0.1:8791 {
#         header_up -X-Realm-Proxy-Secret
#         header_up X-Realm-Proxy-Secret "<this value>"
#     }
# Without the delete, a client that simply SENDS this header can end up with both
# values arriving comma-joined ("junk, <real>"), which never equals the secret —
# so that request fails closed onto the gateway bucket. Fail-closed is right, but
# a caller should not be able to choose it. Generate with: openssl rand -hex 32
#
# At least 32 characters, no surrounding whitespace, or the server refuses to
# boot — a guessable shared secret reads as protection while providing none.
# CUTOVER IS ORDERED, BOTH WAYS. On:  deploy -> Caddy sends the header -> set
# this. Off: unset this FIRST, then remove the header from Caddy. Either
# sequence reversed leaves the service enforcing while the proxy is silent, and
# every client keys on the gateway address in one shared bucket.
#
# LEFT COMMENTED OUT, exactly like REALM_REQUIRE_KNOWN_PROVIDER below and for the
# same reason: an operator who dutifully fills every blank in this file would arm
# enforcement before enspyrco/infra has landed the Caddy half — Caddy silent,
# secret set, every client in one 30/min bucket. That is the outage three tests in
# this repo exist to prevent, invited by a helpful blank. (Tesla, PR #11 round 3.)
# REALM_TRUSTED_PROXY_SECRET=

# Refuse principals whose sign-in method this deployment does not recognise as a
# real sign-in. Exactly "true" or "false"; UNSET means false, and any other value
# makes the server refuse to boot rather than be read as off.
#
# On: /livekit-token admits only a credential whose `prov` is in
# SIGNED_IN_PROVIDERS (src/providers.js) and returns 403 to everything else that
# is validly signed — including anonymous guests, and including a signed-in user
# on a method not in that list. Off (the default) is today's behaviour exactly.
#
# This is a RISK TRIM, not admission control: it removes the throwaway-uid caller,
# not the ability of any signed-in user to request any room. See the README and
# docs/crucible/room-admission/. It is superseded by per-room
# permissions.allowAnonymous once the engine ships it (claude-tasks#3211).
#
# DELIBERATELY LEFT BLANK-FREE: an empty value would be neither "true" nor
# "false" and would restart-loop every laptop that copied this file.
# REALM_REQUIRE_KNOWN_PROVIDER=false

# Optional.
PORT=8080
REALM_CREDENTIAL_TTL_SECONDS=3600
# Dev only: also allow http://localhost:<any-port> (Flutter's dev server picks a
# random port each run). Leave unset in production.
CORS_ALLOW_LOCALHOST=false
