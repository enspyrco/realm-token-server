# Copy to .env (gitignored) and fill in. All values are REQUIRED at startup.

# ES256 keypair for Realm credentials. Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out realm_jwt_private.pem
#   openssl ec -in realm_jwt_private.pem -pubout -out realm_jwt_public.pem
# The PRIVATE key is used ONLY by the /exchange handler; the PUBLIC key ONLY by
# the /livekit-token handler. Newlines may be encoded as literal \n.
REALM_JWT_PRIVATE_KEY=
REALM_JWT_PUBLIC_KEY=

# LiveKit API credentials — the SAME key/secret pair in the box's livekit.yaml.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase project id — the ONLY Firebase config needed. verifyIdToken uses
# Google's public certs, so no service-account JSON is required.
FIREBASE_PROJECT_ID=adventures-in-tech-world-0

# Browser origins allowed to call /exchange and /livekit-token, comma-separated
# and exact-match. REQUIRED — the Flutter web client cannot reach either endpoint
# without it. Never `*`: callers send a bearer credential. Matches the storage
# bucket's CORS policy (world.imagineering.cc).
# Each entry must be exactly scheme://host[:port] — no trailing slash, no path,
# no default port. The server refuses to boot otherwise, because every such
# value matches nothing and is indistinguishable at runtime from no CORS at all.
# Under NODE_ENV=production every entry must be an https DNS name: https alone
# does not exclude loopback (https://app.localhost and https://[::1] are both
# valid https origins), so IP literals and anything under .localhost are refused
# as well.
CORS_ALLOWED_ORIGINS=https://world.imagineering.cc

# How many proxy hops in front of this process are trusted to have written
# X-Forwarded-For. REQUIRED under NODE_ENV=production, which the Dockerfile sets
# — the deployed container is never reached directly, and this value decides
# whether the per-IP rate limit is per-IP at all.
#
# 1 is correct for the OCI box: Caddy terminates TLS and reverse-proxies to
# 127.0.0.1:8791, appending the peer address. Both wrong values fail SILENTLY —
# too low and every request looks like it came from the docker bridge gateway,
# so the whole internet shares one bucket and any single caller throttles
# everyone; too high and a caller supplies its own address per request and the
# limit stops existing. Neither shows up as an error.
TRUST_PROXY_HOPS=1

# Optional.
PORT=8080
REALM_CREDENTIAL_TTL_SECONDS=3600
# Dev only: also allow http://localhost:<any-port> (Flutter's dev server picks a
# random port each run). Leave unset in production.
CORS_ALLOW_LOCALHOST=false
